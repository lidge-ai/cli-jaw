{
  "name": "cli-jaw",
  "version": "2.17.60-preview.20260925003520",
  "description": "Personal AI assistant powered by Pi, Antigravity, Claude, Codex, Codex App, Cursor, Grok, Kiro, OpenCode, and Copilot — Web, Terminal, Slack, Telegram, and Discord interfaces with 33 skills active by default from a 230-skill reference library",
  "type": "module",
  "keywords": [
    "ai-assistant",
    "cli",
    "antigravity",
    "claude",
    "codex",
    "cursor",
    "gemini",
    "grok",
    "pi",
    "copilot",
    "multi-agent",
    "orchestration",
    "telegram-bot",
    "discord-bot",
    "browser-automation",
    "mcp"
  ],
  "author": "CLI-JAW Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidge-jun/cli-jaw.git"
  },
  "homepage": "https://github.com/lidge-jun/cli-jaw#readme",
  "bugs": {
    "url": "https://github.com/lidge-jun/cli-jaw/issues"
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "allowScripts": {
    "better-sqlite3": false
  },
  "bin": {
    "cli-jaw": "dist/bin/cli-jaw.js",
    "jaw": "dist/bin/cli-jaw.js"
  },
  "files": [
    "dist/",
    "!dist/src/lib/native/*.node",
    "public/",
    "scripts/",
    "package.json",
    "!**/[dD][eE][vV][lL][oO][gG]",
    "!**/[dD][eE][vV][lL][oO][gG]/**",
    "!**/[dD][eE][vV][lL][oO][gG][._-]*",
    "!**/[dD][eE][vV][lL][oO][gG][._-]*/**",
    "!**/[cC][lL][iI]-[jJ][aA][wW]-[iI][nN][tT][eE][rR][nN][aA][lL]",
    "!**/[cC][lL][iI]-[jJ][aA][wW]-[iI][nN][tT][eE][rR][nN][aA][lL]/**",
    "!**/_[pP][lL][aA][nN]",
    "!**/_[pP][lL][aA][nN]/**",
    "!**/_[fF][iI][nN]",
    "!**/_[fF][iI][nN]/**",
    "!**/.[jJ][wW][cC]",
    "!**/.[jJ][wW][cC]/**"
  ],
  "scripts": {
    "dev": "tsx --env-file=.env server.ts",
    "ensure:native": "node scripts/ensure-native-modules.cjs",
    "rebuild:native": "npm rebuild better-sqlite3",
    "postinstall": "node scripts/postinstall-guard.cjs",
    "clean:dist": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});\"",
    "check:copilot-gap": "tsx scripts/check-copilot-gap.ts",
    "check:deps": "tsx scripts/check-deps-offline.ts",
    "check:deps:audit": "tsx scripts/check-deps-audit.ts",
    "check:strict-baseline": "node scripts/check-strict-baseline.mjs",
    "check:path-length": "node scripts/check-path-length.mjs",
    "docs:check": "tsx scripts/docs/check-docs.mts",
    "docs:windows": "tsx scripts/render-windows-support.mts",
    "docs:channel-capabilities": "tsx scripts/generate-channel-capability-table.mts",
    "check:frontend-build-output": "tsx scripts/check-web-ui-build-output.ts",
    "i18n:registry": "tsx scripts/i18n-registry.ts",
    "check:deps:online": "bash scripts/check-deps-online.sh",
    "prebuild": "npm run ensure:native",
    "pretest": "npm run ensure:native",
    "pretest:all": "npm run ensure:native",
    "pretest:integration": "npm run ensure:native",
    "pretest:smoke": "npm run ensure:native",
    "test": "tsx --experimental-test-module-mocks tests/run.mts",
    "test:all": "tsx --experimental-test-module-mocks tests/run.mts --all",
    "test:shard": "tsx --experimental-test-module-mocks tests/run.mts --scope root,unit --shard",
    "test:integration:all": "tsx --experimental-test-module-mocks tests/run.mts --scope integration,manager,bin",
    "test:integration": "tsx --experimental-test-module-mocks --test tests/integration/*.test.ts",
    "test:coverage": "tsx --experimental-test-module-mocks --experimental-test-coverage tests/run.mts --all",
    "test:watch": "tsx --experimental-test-module-mocks tests/run.mts --watch",
    "test:web-ui-runtime": "tsx --import ./tests/setup/test-home.ts --experimental-test-module-mocks --test tests/unit/web-ui-runtime-*.test.ts tests/unit/web-ui-processblock-runtime.test.ts tests/unit/web-ui-mermaid-runtime.test.ts tests/unit/web-ui-sanitizer.test.ts tests/unit/web-ui-build-output-guard.test.ts",
    "test:events": "tsx --test tests/events.test.ts",
    "test:telegram": "tsx --test tests/telegram-forwarding.test.ts",
    "test:manager:browser": "tsx --test tests/browser/manager-layout-smoke.test.ts",
    "test:smoke": "node scripts/run-with-env.mjs TEST_PORT=3457 -- tsx --test tests/integration/api-smoke.test.ts",
    "smoke:opencode": "tsx scripts/smoke/opencode-external-dir-smoke.ts",
    "smoke:retired-runtime:package": "node scripts/retired-runtime-package-smoke.mjs",
    "test:install-risk": "node scripts/install-risk-gate.mjs",
    "test:waf": "node scripts/run-with-env.mjs WAF_TEST_ENABLED=1 -- tsx tests/waf/waf-runner.ts",
    "verify:fresh-install": "bash scripts/verify-fresh-install.sh",
    "collect:fresh-install-evidence": "bash scripts/collect-fresh-install-evidence.sh",
    "audit:fresh-install-evidence": "node scripts/audit-fresh-install-evidence.mjs",
    "verify:release-evidence": "node scripts/verify-release-evidence.mjs",
    "test:fresh-install": "tsx scripts/fresh-install-smoke.ts",
    "build": "bash scripts/atomic-build.sh",
    "postbuild": "bash scripts/verify-dist-assets.sh && node scripts/link-current-nvm-bin.cjs",
    "build:frontend": "vite build --config vite.config.ts",
    "qa:manager-frontend": "npm run build:frontend && npm run typecheck:frontend",
    "dev:frontend": "vite --config vite.config.ts",
    "preview:frontend": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "gate:typecheck": "node scripts/release-gates.mjs typecheck",
    "gate:tests": "node scripts/release-gates.mjs tests",
    "gate:truth-table-fresh": "node scripts/release-gates.mjs truth-table-fresh",
    "gate:mcp-scope-frozen": "node scripts/release-gates.mjs mcp-scope-frozen",
    "gate:no-experimental-in-readme-ready-section": "node scripts/release-gates.mjs no-experimental-in-readme-ready-section",
    "gate:no-cloud-claims": "node scripts/release-gates.mjs no-cloud-claims",
    "gate:observe-actions-fixtures": "node scripts/release-gates.mjs observe-actions-fixtures",
    "gate:observation-bundle-fixtures": "node scripts/release-gates.mjs observation-bundle-fixtures",
    "gate:browser-primitives-catalog": "node scripts/release-gates.mjs browser-primitives-catalog",
    "gate:action-memory-safe-replay": "node scripts/release-gates.mjs action-memory-safe-replay",
    "gate:model-adapter-frozen": "node scripts/release-gates.mjs model-adapter-frozen",
    "gate:workflow-common-layer-no-sdk": "node scripts/release-gates.mjs workflow-common-layer-no-sdk",
    "gate:doc-drift": "node scripts/release-gates.mjs doc-drift",
    "gate:strict-baseline": "node scripts/release-gates.mjs strict-baseline",
    "gate:redaction-sinks": "node scripts/release-gates.mjs redaction-sinks",
    "gate:electron-version": "node scripts/release-gates.mjs electron-version",
    "gate:gate-docs": "node scripts/release-gates.mjs gate-docs",
    "gate:sidecar-prune-safety": "node scripts/release-gates.mjs sidecar-prune-safety",
    "gate:native-load": "node scripts/release-gates.mjs native-load",
    "gate:sidecar-smoke": "node scripts/release-gates.mjs sidecar-smoke",
    "gate:install-integrity": "node scripts/release-gates.mjs install-integrity",
    "gate:messaging-conformance": "node scripts/release-gates.mjs messaging-conformance",
    "gate:path-length": "node scripts/release-gates.mjs path-length",
    "test:messaging-conformance": "tsx --experimental-test-module-mocks tests/run.mts tests/unit/channel-contract-conformance.test.ts tests/unit/messaging-command-parity.test.ts tests/unit/messaging-durable-ingress.test.ts tests/unit/telegram-ingress-journal.test.ts tests/unit/discord-ingress-journal.test.ts tests/unit/ingress-generation.test.ts tests/unit/messaging-trace-context.test.ts tests/unit/messaging-metrics.test.ts",
    "check:sidecar-prune-safety": "node scripts/check-sidecar-prune-safety.mjs",
    "sync:electron-version": "node scripts/sync-electron-version.cjs",
    "gate:all": "node scripts/release-gates.mjs",
    "prepublishOnly": "npm run check:private-boundary && npm run build && npm run build:frontend && npm run check:frontend-build-output",
    "electron:dev": "concurrently -k -n jaw,electron \"node scripts/electron-dev-manager.mjs\" \"npm --prefix electron run dev\"",
    "electron:build": "npm --prefix electron run build",
    "sidecar:bundle": "bash scripts/bundle-sidecar.sh darwin arm64",
    "electron:dist:mac": "npm run build:frontend && npm run sidecar:bundle && npm --prefix electron run build && CSC_IDENTITY_AUTO_DISCOVERY=false npm --prefix electron run dist:mac && npm run electron:resign:mac && npm run check:electron-dist-mac-no-jwc && npm run check:app-icons",
    "electron:resign:mac": "codesign --force --deep --sign - electron/dist/mac-arm64/cli-jaw.app",
    "electron:dist:mac:signed": "npm run build:frontend && npm run sidecar:bundle && npm --prefix electron run build && npm --prefix electron run dist:mac -- --config.mac.notarize=true --config.dmg.sign=true --publish never && node scripts/notarize-mac-dmg.mjs && npm run check:electron-dist-mac-no-jwc && npm run check:app-icons && npm run verify:electron-update-metadata && npm run verify:mac-signature && npm run verify:mac-dmg",
    "verify:mac-signature": "node scripts/verify-mac-signature.mjs electron/dist/mac-arm64/cli-jaw.app",
    "verify:mac-dmg": "node scripts/verify-mac-signature.mjs --dmg",
    "verify:electron-update-metadata": "node scripts/verify-electron-update-metadata.mjs electron/dist electron/dist/mac-arm64/cli-jaw.app/Contents/Resources/app-update.yml",
    "electron:start": "npm --prefix electron run start",
    "check:cli-bin-links": "node scripts/check-cli-bin-links.cjs",
    "check:electron-sidecar-no-jwc": "node scripts/check-electron-sidecar-no-jwc.cjs",
    "check:electron-dist-mac-no-jwc": "node scripts/check-electron-sidecar-no-jwc.cjs --server-root electron/dist/mac-arm64/cli-jaw.app/Contents/Resources/server",
    "check:electron-dist-win-no-jwc": "node scripts/check-electron-sidecar-no-jwc.cjs --server-root electron/dist/win-unpacked/resources/server",
    "check:electron-dist-linux-no-jwc": "node scripts/check-electron-sidecar-no-jwc.cjs --server-root electron/dist/linux-unpacked/resources/server",
    "check:app-icons": "node scripts/check-app-icon-assets.cjs",
    "check:electron-no-native": "node scripts/check-electron-no-native.cjs",
    "smoke:tui-fullscreen": "tsx scripts/smoke/tui-fullscreen-frame-smoke.ts",
    "verify:dist-assets": "bash scripts/verify-dist-assets.sh",
    "check:private-boundary": "node scripts/check-private-boundary.mjs"
  },
