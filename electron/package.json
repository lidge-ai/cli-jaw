{
  "name": "cli-jaw-electron",
  "version": "2.17.53-preview.20260916144726",
  "description": "Electron desktop shell for cli-jaw manager dashboard",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist:mac": "node ../scripts/run-electron-builder.mjs --mac",
    "dist:mac:zip": "node ../scripts/run-electron-builder.mjs --mac zip",
    "dist:win": "node ../scripts/run-electron-builder.mjs --win",
    "dist:linux": "node ../scripts/run-electron-builder.mjs --linux",
    "dist:all": "node ../scripts/run-electron-builder.mjs -mwl"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^41.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "fix-path": "^4.0.0",
    "node-pty": "^1.1.0"
  }
}
